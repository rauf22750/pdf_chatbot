{
  "version": 2,
  "builds": [
    {
      "src": "pdf_chatbot/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "runtime": "python3.9"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "pdf_chatbot/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "pdf_chatbot.settings"
  },
  "buildCommand": "pip install -r requirements.txt && python manage.py migrate"
}