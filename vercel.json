{
    "version": 2,
    "builds": [
      {
        "src": "pdf_chatbot/wsgi.py",
        "use": "@vercel/python",
        "config": {
          "maxLambdaSize": "15mb",
          "runtime": "python3.9",
          "buildCommand": "python3 -m pip install -r requirements.txt && python3 manage.py collectstatic --noinput"
        }
      }
    ],
    "routes": [
      {
        "src": "/static/(.*)",
        "dest": "/static/$1"
      },
      {
        "src": "/(.*)",
        "dest": "pdf_chatbot/wsgi.py"
      }
    ]
  }