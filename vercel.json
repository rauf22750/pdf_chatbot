{
  "version": 2,
  "builds": [
    {
      "src": "pdf_chatbot/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.9"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "pdf_chatbot/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "pdf_chatbot.settings",
    "PYTHONPATH": "."
  }
}

