{
  "version": 2,
  "builds": [
    {
      "src": "manage.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "runtime": "python3.10"
      }
    },
    {
      "src": "build_files.sh",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "staticfiles"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "manage.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "pdf_chatbot.settings",
    "DATABASE_URL": "postgresql://postgres:xNtJNnerrCafobStUZXyVsvEIyGfEPDd@viaduct.proxy.rlwy.net:12511/railway",
    "DJANGO_SECRET_KEY": "218c8992941d1b6e8fc0edfb3376e2d0dff7a18f",
    "DEBUG": "False",
    "GROQ_API_KEY":"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"
  },
  "hooks": {
    "build": "python manage.py migrate && python manage.py collectstatic --noinput"
  }
}
